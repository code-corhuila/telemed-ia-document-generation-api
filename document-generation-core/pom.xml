<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>co.edu.corhuila.telemedia</groupId>
        <artifactId>document-generation-api</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>document-generation-core</artifactId>
    <name>document-generation-core</name>
    <description>Domain model, ports and use cases. Declares no framework dependency (numeral 5.3.3).</description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Numeral 5.3.3: the core must not depend on a web, persistence or
                messaging framework. Adding one of these artifacts fails the build,
                so the rule is checked by the compiler pipeline, not by review.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-framework-free-core</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.springframework*</exclude>
                                        <exclude>jakarta.persistence</exclude>
                                        <exclude>jakarta.servlet</exclude>
                                        <exclude>org.hibernate*</exclude>
                                        <exclude>org.postgresql</exclude>
                                        <exclude>com.rabbitmq</exclude>
                                        <exclude>io.minio</exclude>
                                    </excludes>
                                    <message>document-generation-core must not depend on frameworks or drivers (numeral 5.3.3).</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
