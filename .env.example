# Variables read by telemed-ia-document-generation-api.
# Real values come from the environment file of telemed-ia-infra-postgres
# (env/dev.env, env/qa.env, env/main.env). Never commit real values.

# HTTP port inside the container.
SERVER_PORT=8080

# Public key of the identity service, used to validate RS256 access tokens.
# PEM in one line with literal \n, for example:
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjAN...\n-----END PUBLIC KEY-----
# Alternatively, JWT_PUBLIC_KEY_FILE with the path to the PEM file.
# It is a public key: the service never holds the private key.
JWT_PUBLIC_KEY=

# Shared PostgreSQL instance (Anexo J), application user of this domain.
DB_URL=jdbc:postgresql://localhost:5432/telemed_ia
DB_USER=document_generation_app
DB_PASSWORD=

# S3-compatible object storage of the PDFs (ADR-015, ADR-021): the
# object-storage service (RustFS) of telemed-ia-infra-postgres.
# Internal endpoint, for storage operations.
STORAGE_ENDPOINT=http://localhost:9000
# Endpoint the browser reaches; download URLs are signed for it.
# Defaults to STORAGE_ENDPOINT when empty.
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=telemed-documents
STORAGE_REGION=us-east-1
# Validity of a download URL, in seconds (5 minutes).
STORAGE_PRESIGNED_TTL_SECONDS=300

# Only for the integration tests (Anexo C). Without it they are skipped.
# TEST_DATABASE_URL=jdbc:postgresql://localhost:5432/telemed_ia?user=document_generation_app&password=...
